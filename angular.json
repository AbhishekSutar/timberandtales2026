{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "timber-and-tales": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "tt",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/timber-and-tales",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [{"glob": "**/*", "input": "public"}],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {"type": "initial", "maximumWarning": "800kB", "maximumError": "1MB"},
                {"type": "anyComponentStyle", "maximumWarning": "8kB", "maximumError": "12kB"}
              ],
              "outputHashing": "all"
            },
            "development": {"optimization": false, "extractLicenses": false, "sourceMap": true}
          },
          "defaultConfiguration": "production"
        },
        "serve": {
  "builder": "@angular/build:dev-server",
  "configurations": {
    "production": {
      "buildTarget": "timber-and-tales:build:production"
    },
    "development": {
      "buildTarget": "timber-and-tales:build:development"
    }
  },
  "defaultConfiguration": "development"
}
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
